# Порт, на котором слушает Express
PORT=4000

# Откуда разрешаем запросы (адрес фронта на Vite)
CLIENT_ORIGIN=http://localhost:5173

# Подключение к PostgreSQL (совпадает с docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=videocall
DB_USER=videocall
DB_PASSWORD=videocall

# Секрет для подписи JWT (в реальном проекте — длинная случайная строка, не коммитить)
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# LiveKit (SFU для видеозвонков). URL — куда клиент подключается по WebSocket.
# KEY/SECRET — пара из livekit.yaml, ими бэк подписывает токены доступа в комнату.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=videocall
LIVEKIT_API_SECRET=change_me

# GitHub OAuth (вход через GitHub). Заведи OAuth App: https://github.com/settings/developers
# Callback URL приложения должен совпадать с GITHUB_CALLBACK_URL ниже.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
